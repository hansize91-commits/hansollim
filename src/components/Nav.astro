---
import { withBase } from '../lib/base';

interface Props {
  current?: string;
}

const { current = '' } = Astro.props;

const links = [
  { href: withBase('/'), label: 'Hansol', id: 'home' },
  { href: withBase('/cv'), label: 'CV', id: 'cv' },
  { href: withBase('/solo'), label: '개인전', id: 'solo' },
  { href: withBase('/group'), label: '단체전', id: 'group' },
  { href: withBase('/mapaduboo'), label: '마파두부', id: 'mapaduboo' },
  { href: withBase('/sseuim'), label: '독립출판사 쓰임', id: 'sseuim' },
];
---

<nav class="nav" aria-label="메뉴">
  {
    links.map((link) => (
      <a href={link.href} aria-current={current === link.id ? 'page' : undefined}>
        {link.label}
      </a>
    ))
  }
</nav>
