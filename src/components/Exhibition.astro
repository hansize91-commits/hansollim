---
import {
  dateLine,
  paragraphAlign,
  paragraphs,
  exhibitionPhotos,
  posterFile,
  type ExhibitionEntry,
} from '../lib/exhibitions';

interface Props {
  entry: ExhibitionEntry;
  heading?: 'h1' | 'h2';
}

const { entry, heading = 'h2' } = Astro.props;
const photos = exhibitionPhotos(entry.data.photos ?? entry.id, entry.data.gallery);
const poster = posterFile(entry.data.photos ?? entry.id, entry.data.poster);
const body = paragraphs(entry.body);
const artists = entry.data.artists ?? [];
---

<article class="exhibition" id={entry.id}>
  <header class="exhibition-head">
    {
      heading === 'h1' ? (
        <h1>{entry.data.title}</h1>
      ) : (
        <h2>
          <a href={`/exhibitions/${entry.id}`}>{entry.data.title}</a>
        </h2>
      )
    }
    {entry.data.subtitle && <p class="subtitle">{entry.data.subtitle}</p>}
    {entry.data.titleEn && <p class="title-en">{entry.data.titleEn}</p>}
    <p class="meta">
      {dateLine(entry.data) && <span>{dateLine(entry.data)}</span>}
      {entry.data.venue && <span>{entry.data.venue}</span>}
      {artists.length > 0 && <span>참여 작가 {artists.join(', ')}</span>}
      {entry.data.hours && <span>{entry.data.hours}</span>}
      {entry.data.organizer && <span>{entry.data.organizer}</span>}
      {entry.data.closed && <span>{entry.data.closed}</span>}
      {entry.data.opening && <span>{entry.data.opening}</span>}
    </p>
  </header>

  {
    body.length > 0 && (
      <div class="prose">
        {body.map((text) => (
          <p class={paragraphAlign(text)}>{text}</p>
        ))}
      </div>
    )
  }

  {
    poster && (
      <figure class="poster">
        <button type="button" data-full={poster} aria-label={`${entry.data.title} 포스터 크게 보기`}>
          <img src={poster} alt={`${entry.data.title} 포스터`} />
        </button>
      </figure>
    )
  }

  {
    photos.length > 0 && (
      <ul class="photos">
        {photos.map((src, index) => (
          <li>
            <button type="button" data-full={src} aria-label={`${entry.data.title} 사진 ${index + 1} 크게 보기`}>
              <img src={src} alt={`${entry.data.title} ${index + 1}`} loading="lazy" />
            </button>
          </li>
        ))}
      </ul>
    )
  }
</article>
